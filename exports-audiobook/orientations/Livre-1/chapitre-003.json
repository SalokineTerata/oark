  "sha256_source": "d7e21bb2fdc21f74993966aac47ef4dfbe2e983220c9d29fc28be74f49319e30",
  "modele_analyse": "qwen2.5:3b",
  "segments": [
    {
      "id": 1,
      "type": "chapitre",
      "texte": "Chapitre 3 — Le poids d’une découverte",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.2,
      "dominance": 0.8,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 2,
      "type": "narration",
      "texte": "Le sas de décontamination s’ouvrit sur l’odeur familière du filtre chaud et du café.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 0.8,
      "activation": 0.7,
      "dominance": 0.6,
      "intensite": 0.3,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 3,
      "type": "narration",
      "texte": "Koda passa d’abord ses bottes et ses gants sous les jets, puis attendit la lecture des capteurs. Rien d’anormal. Elle déposa les deux sachets de minerai sur la table de réception, avec leurs coordonnées et leurs relevés. Le fragment, dans sa petite caisse, attendait à côté de son casque.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 0.8,
      "activation": 0.7,
      "dominance": 0.6,
      "intensite": 0.3,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 4,
      "type": "narration",
      "texte": "Le technicien de quart parcourut la fiche du gisement.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 0.8,
      "activation": 0.7,
      "dominance": 0.6,
      "intensite": 0.3,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 5,
      "type": "dialogue",
      "texte": "— Les deux échantillons viennent de la même couche ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 6,
      "type": "dialogue",
      "texte": "— Oui. Je les ai pris à deux endroits. La veine continue sous l’éboulis, mais je n’ai pas pu en voir la fin.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "confusion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 7,
      "type": "dialogue",
      "texte": "— Je les passe au laboratoire.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.7,
      "dominance": 0.5,
      "intensite": 0.8,
      "intention": "ordonner",
      "vocalisation": "parole"
    },
    {
      "id": 8,
      "type": "narration",
      "texte": "Il saisit la caisse du fragment et souleva le couvercle.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.7,
      "dominance": 0.5,
      "intensite": 0.8,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 9,
      "type": "dialogue",
      "texte": "— Et ça, ça ne va pas dans le broyeur d’échantillons, je suppose ?",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 10,
      "type": "dialogue",
      "texte": "— Je préférerais éviter. C’est un composant oarkin.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 11,
      "type": "dialogue",
      "texte": "— Jaro va perdre son pari.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 12,
      "type": "dialogue",
      "texte": "— Quel pari ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 13,
      "type": "dialogue",
      "texte": "— Il disait que tu reviendrais avec trois cailloux et une histoire sur les ancêtres. Il n’avait pas prévu la pièce en prime.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 14,
      "type": "narration",
      "texte": "Koda nota l’objet sur la fiche locale des trouvailles de terrain, comme elle l’avait fait pour d’autres fragments. Le technicien lui rendit la caisse et emporta les sachets de minerai.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 0.5,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.7,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 15,
      "type": "narration",
      "texte": "Au réfectoire, le débrief avait déjà commencé. Les pilotes discutaient des images du drone et Jaro racontait comment le moteur avait failli s’éteindre au-dessus du plateau. Borras gardait une place libre à côté de lui.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 0.5,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.7,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 16,
      "type": "dialogue",
      "texte": "— Tu nous montres ta veine ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 17,
      "type": "narration",
      "texte": "demanda-t-il.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 18,
      "type": "narration",
      "texte": "Koda fit défiler les photos de la paroi. Elle indiqua les points de prélèvement, la pente d’accès et la partie masquée par l’éboulis. Le pilote rapprocha les images du drone de sa carte. Une foreuse légère pourrait atteindre l’entrée, mais il faudrait vérifier la place pour manœuvrer à l’intérieur.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 19,
      "type": "dialogue",
      "texte": "— Si les analyses confirment la teneur, on envoie une équipe mesurer le prolongement,",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 20,
      "type": "narration",
      "texte": "dit Borras.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 21,
      "type": "dialogue",
      "texte": "— Et le toit,",
      "locuteur": "KODA",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 22,
      "type": "narration",
      "texte": "ajouta Koda.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 23,
      "type": "dialogue",
      "texte": "Je n’aimerais pas le voir tomber sur la foreuse.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 24,
      "type": "narration",
      "texte": "Borras prit les relevés sur sa tablette pour préparer le compte rendu quotidien. Koda tourna ensuite l’écran vers lui et lui montra la photographie de la niche.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 25,
      "type": "dialogue",
      "texte": "— J’ai trouvé ça derrière la veine. Un composant d’une ancienne technologie oarkine.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 26,
      "type": "dialogue",
      "texte": "— Ah. Tu as réussi à travailler et à faire tes fouilles le même jour.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 1,
      "dominance": 0.75,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 27,
      "type": "dialogue",
      "texte": "— Dans cet ordre.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 1,
      "dominance": 0.75,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 28,
      "type": "dialogue",
      "texte": "— Tu sais à quoi il servait ?",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 1,
      "dominance": 0.75,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 29,
      "type": "dialogue",
      "texte": "— Pas encore. Il est différent des fragments décrits dans les archives que j’ai lues.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 30,
      "type": "narration",
      "texte": "Borras lui demanda de lui envoyer la photo : il avait promis à Jaro de lui montrer ses trouvailles. Koda partagea aussi les relevés de la niche avec les autres données de sa sortie. Tout en complétant le compte rendu du gisement, Borras nota la découverte de son amie et joignit les fichiers de terrain, comme il le faisait pour les observations de la journée.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 31,
      "type": "narration",
      "texte": "Il transmit le rapport avec les autres relevés de la journée et posa sa tablette. Sur l’écran du réfectoire, les nouvelles du front annonçaient une nouvelle réduction des réserves de carburant. Le pilote demanda combien de temps prendrait l’analyse des échantillons. Le technicien leva deux doigts depuis la porte : deux jours, si le laboratoire ne tombait pas en panne.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 32,
      "type": "narration",
      "texte": "Jaro s’approcha avec son plateau.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 33,
      "type": "dialogue",
      "texte": "— Alors c’est vrai ? Tu as trouvé un trésor ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 34,
      "type": "dialogue",
      "texte": "— Un morceau de métal muet dans un trou noir.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 35,
      "type": "dialogue",
      "texte": "— Et une veine qui pourrait alimenter des générateurs,",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 36,
      "type": "narration",
      "texte": "ajouta Borras.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 37,
      "type": "dialogue",
      "texte": "— La veine, c’est pour le camp,",
      "locuteur": "KODA",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.75,
      "dominance": 0.5,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 38,
      "type": "narration",
      "texte": "dit Koda.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.75,
      "dominance": 0.5,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 39,
      "type": "dialogue",
      "texte": "Le morceau de métal, c’est pour ma soirée.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.75,
      "dominance": 0.5,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 40,
      "type": "dialogue",
      "texte": "— J’aime cette discipline,",
      "locuteur": "JARO",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.75,
      "dominance": 0.5,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 41,
      "type": "narration",
      "texte": "dit Jaro.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 42,
      "type": "dialogue",
      "texte": "Elle me correspond.",
      "locuteur": "JARO",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 43,
      "type": "narration",
      "texte": "Le rire se propagea autour de la table. Quelqu’un demanda à Koda si elle allait encore passer la nuit dans son atelier. Elle répondit qu’elle essaierait de dormir avant de démonter tout ce qu’elle trouvait. Personne ne la crut.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 44,
      "type": "narration",
      "texte": "Borras lui rappela qu’elle avait promis de l’aider à réparer un vieux projecteur pour la salle commune. Elle prétendit ne pas se souvenir de cette promesse; il cita la date, le lieu et la ration de dessert qu’elle lui avait volée en échange. Koda admit qu’il avait peut-être raison. Le projecteur attendrait. Elle voulait d’abord voir si le fragment avait une réponse mesurable, même négative.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 45,
      "type": "narration",
      "texte": "Ils se connaissaient depuis l’enfance, bien avant que l’un soit chargé des transmissions et l’autre des sorties de terrain. Leur amitié avait survécu aux affectations, aux disputes et aux mois où ils n’avaient presque pas parlé d’autre chose que du travail. Koda n’avait pas à chercher une manière de lui annoncer la découverte : elle avait simplement attendu le moment où ils débriefferaient leur journée, comme ils l’avaient fait tant de fois.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 46,
      "type": "narration",
      "texte": "Après le repas, elle porta la caisse dans son atelier. Elle relut les données de terrain, nota l’heure et les conditions de prélèvement, puis ouvrit l’enveloppe isolante.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 47,
      "type": "narration",
      "texte": "À la lumière du camp, la surface du fragment paraissait plus sombre. Koda le tourna lentement entre ses doigts, cherchant une rainure, une gravure ou une trace d’usure. Il n’avait rien d’un minerai et ne ressemblait pas aux composants contemporains. C’était déjà intéressant.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 48,
      "type": "narration",
      "texte": "Elle enregistra une première série de mesures, puis une seconde. Masse inhabituelle, conductivité difficile à établir, aucune réaction nette aux appareils disponibles. Elle conserva les chiffres dans son carnet d’atelier.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.7,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 49,
      "type": "narration",
      "texte": "Après avoir enregistré les résultats, Koda installa la lampe au-dessus de l’établi. Elle ouvrit son protocole et prépara une première série de mesures contrôlées.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 50,
      "type": "narration",
      "texte": "Le soir même, les premiers essais au banc ne donnèrent aucune réaction.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 51,
      "type": "narration",
      "texte": "Koda l’avait vérifié trois fois, avec trois niveaux de tension différents. Elle avait d’abord utilisé une alimentation de drone réglée au minimum, puis une batterie de secours, puis les pinces de son vieux testeur analogique. À chaque essai, l’écran de son terminal restait noir. La surface ne chauffait pas. Aucun voyant, aucun signal, aucune variation mesurable.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 52,
      "type": "narration",
      "texte": "Elle s’était arrêtée avant de faire une bêtise.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 53,
      "type": "narration",
      "texte": "Les réparateurs apprenaient tôt à ne pas insister quand un appareil ne répondait pas. Injecter du courant à l’aveugle était un bon moyen de l’endommager.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 54,
      "type": "narration",
      "texte": "Koda avait donc choisi l’option la moins risquée : comprendre d’abord comment l’objet réagissait. Elle installa sur son établi le support de mesure et ouvrit son carnet personnel sur l’écran voisin. Elle y noterait chaque lecture, y compris les résultats nuls.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 55,
      "type": "narration",
      "texte": "Elle monta un circuit de mesure sur une plaque d’essai, sépara l’alimentation du terminal et plaça entre les deux un régulateur bricolé à partir de pièces de drone. Un fil de terre, deux résistances, un fusible thermique. Rien d’élégant, mais elle connaissait chaque élément. Si le circuit chauffait, elle le verrait. S’il envoyait une surtension, le fusible couperait.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 56,
      "type": "narration",
      "texte": "Elle approcha le fragment des capteurs.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 57,
      "type": "narration",
      "texte": "Rien.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 58,
      "type": "narration",
      "texte": "Koda modifia la fréquence de lecture, recommença, puis inversa les polarités. L’écran resta vide. Elle se recula, observa les fils, vérifia les soudures et recommença le test. Même absence de réponse.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 59,
      "type": "narration",
      "texte": "À deux heures du matin, elle abandonna.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 60,
      "type": "narration",
      "texte": "Elle couvrit l’objet avec le chiffon et s’allongea sur son lit sans se déshabiller. Le sommeil ne vint pas tout de suite. Elle repassa les mesures de la soirée, puis finit par s’endormir.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 61,
      "type": "narration",
      "texte": "Le lendemain matin, elle se réveilla avant l’alarme. Le vent faisait vibrer les panneaux extérieurs du module. Elle rangea son carnet et couvrit le fragment : les drones avaient repéré un autre secteur à examiner, et le véhicule devait partir après le petit déjeuner.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "narrer",
      "vocalisation": "parole"
    },
    {
      "id": 62,
      "type": "narration",
      "texte": "Elle rejoignit les autres au réfectoire. Borras n’avait pas sa tablette devant lui; il tenait un gobelet fumant à deux mains et regardait les nouvelles du front sur l’écran mural. Les images montraient une colonne de transporteurs immobilisés près d’une crevasse. Une voix automatique lisait les informations sans intonation.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "narrer",
      "vocalisation": "parole"
    },
    {
      "id": 63,
      "type": "dialogue",
      "texte": "— Le convoi est bloqué ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 64,
      "type": "narration",
      "texte": "demanda Koda en posant son plateau.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 65,
      "type": "dialogue",
      "texte": "— Depuis six heures. Ils attendent qu’une équipe sécurise le passage.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 66,
      "type": "dialogue",
      "texte": "— Ils ont assez de carburant pour patienter ?",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 67,
      "type": "narration",
      "texte": "Borras haussa les épaules.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 68,
      "type": "dialogue",
      "texte": "— Ils n’ont pas le choix.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 69,
      "type": "narration",
      "texte": "La réponse resta entre eux. Koda remua sa ration avec sa fourchette.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 70,
      "type": "dialogue",
      "texte": "— Tu as pu faire parler ton caillou ?",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 71,
      "type": "narration",
      "texte": "demanda-t-il.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 72,
      "type": "dialogue",
      "texte": "— Il ne parle pas, ne chauffe pas et refuse de conduire l’électricité.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 73,
      "type": "dialogue",
      "texte": "— Donc, il est plus poli que Jaro.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 74,
      "type": "dialogue",
      "texte": "— Je ne voudrais pas aller jusque-là.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 75,
      "type": "narration",
      "texte": "Borras sourit et poussa vers elle une tasse de café.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 76,
      "type": "dialogue",
      "texte": "— J’ai terminé une première série de mesures,",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 77,
      "type": "narration",
      "texte": "dit-elle.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.7,
      "dominance": 0.3,
      "intensite": 0.8,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 78,
      "type": "dialogue",
      "texte": "Rien qui permette d’identifier sa fonction.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 79,
      "type": "dialogue",
      "texte": "— Fais attention à ne pas lui apprendre à mordre.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 80,
      "type": "dialogue",
      "texte": "— Je lui donnerai ton nom.",
      "locuteur": "BORRAS",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.7,
      "dominance": 0.3,
      "intensite": 0.8,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 81,
      "type": "narration",
      "texte": "Leurs tasses se heurtèrent quand Borras leva la sienne. Pour quelques secondes, la guerre et les pannes du camp tinrent à distance.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 82,
      "type": "narration",
      "texte": "Après le petit déjeuner, Koda chargea son radar et les balises dans le véhicule. Le drone du matin avait balayé un plateau à l’est du camp et signalé deux zones de densité élevée. Elle rejoignit la première par une piste déjà reconnue, gara le véhicule sur la roche ferme et continua à pied.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 83,
      "type": "narration",
      "texte": "La première lecture paraissait prometteuse. À la deuxième, prise plus loin, le signal s’amincit. Une troisième mesure révéla une couche superficielle qui suivait la pente sans s’enfoncer. Koda recalibra la sonde, préleva un éclat et reprit le profil. Le minerai recherché était présent, mais en quantité trop faible aux points mesurés. Elle nota les valeurs et laissa à l’équipe d’analyse le soin de vérifier l’échantillon.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 84,
      "type": "narration",
      "texte": "Au second point, le terrain descendait dans un couloir de blocs. Elle dut contourner une plaque instable et déplacer une balise pour conserver la liaison. À midi, elle mangea debout, à l’ombre du véhicule, avant de retourner finir les mesures. Le drone lui avait montré où regarder; il ne pouvait pas lui dire si elle poserait le pied sur une dalle solide.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.7,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 85,
      "type": "narration",
      "texte": "Le relevé terminé, elle transmit sa position de retour et rentra avec de la poussière jusque dans les plis de sa combinaison. Jaro l’attendait près du sas, un boîtier de capteur à la main.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.85,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 86,
      "type": "dialogue",
      "texte": "— Deux secteurs,",
      "locuteur": "JARO",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.85,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 87,
      "type": "narration",
      "texte": "dit-elle.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.85,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 88,
      "type": "dialogue",
      "texte": "Pas de veine comparable à celle d’hier.",
      "locuteur": "JARO",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.85,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 89,
      "type": "dialogue",
      "texte": "— Et mon roulement ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.7,
      "intensite": 0.9,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 90,
      "type": "narration",
      "texte": "Elle examina le drone posé à ses pieds. La pale vibrait même quand Jaro la tournait à la main.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.8,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 91,
      "type": "dialogue",
      "texte": "— Ton axe a pris un coup. Change-le avant le prochain vol.",
      "locuteur": "JARO",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.8,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 92,
      "type": "dialogue",
      "texte": "— J’espérais une réparation plus courte.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.9,
      "dominance": 0.8,
      "intensite": 0.8,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 93,
      "type": "dialogue",
      "texte": "— Tu peux toujours menacer le drone.",
