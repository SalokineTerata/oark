  "segments": [
    {
      "id": 1,
      "type": "chapitre",
      "texte": "Chapitre 5 — Étincelle de vie",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "cri"
    },
    {
      "id": 2,
      "type": "narration",
      "texte": "Les jours suivants, Koda continua les sorties de prospection. Le soir, quand elle avait encore l’énergie, elle reprenait ses notes et observait le composant oarkin dans son atelier. Les relevés optiques et thermiques n’avaient pas permis d’en déterminer la fonction.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "cri"
    },
    {
      "id": 3,
      "type": "narration",
      "texte": "Un soir, après une journée passée à mesurer les pentes au nord du plateau, elle abandonna les capteurs de terrain. Elle démonta un vieux terminal d’atelier, conserva son interface d’entrée-sortie et remplaça le contrôleur par un module de diagnostic. Si le fragment disposait d’un protocole de communication, elle ne le trouverait peut-être pas en l’alimentant; il fallait l’écouter.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "cri"
    },
    {
      "id": 4,
      "type": "narration",
      "texte": "Elle n’avait pas de raison de penser que ça fonctionnerait. Elle avait seulement épuisé les méthodes qu’elle connaissait.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "cri"
    },
    {
      "id": 5,
      "type": "narration",
      "texte": "Koda posa le fragment sur un support isolant, raccorda les sondes au circuit de mesure et lança une lecture passive. L’ordinateur afficha une ligne, puis une seconde.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 6,
      "type": "narration",
      "texte": "Entrée non reconnue.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 7,
      "type": "narration",
      "texte": "Elle cligna des yeux.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 8,
      "type": "narration",
      "texte": "Le message venait de son propre logiciel de diagnostic. Il pouvait s’agir d’un faux positif; une variation dans le circuit, un bruit électromagnétique, un fil mal soudé. Koda vérifia les connexions. Tout était stable.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 9,
      "type": "narration",
      "texte": "Elle relança la lecture.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 10,
      "type": "narration",
      "texte": "Entrée non reconnue.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 11,
      "type": "narration",
      "texte": "Le terminal avait détecté quelque chose.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 12,
      "type": "narration",
      "texte": "Pas assez pour communiquer. Assez pour distinguer l’absence de signal d’une présence qu’il ne comprenait pas.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "soupir"
    },
    {
      "id": 13,
      "type": "narration",
      "texte": "Koda s’assit plus près de l’écran. Elle activa l’enregistrement brut et réduisit la sensibilité du contrôleur pour éviter que le bruit de fond ne sature les données. Un motif apparut, régulier mais trop rapide pour être affiché. Elle ralentit l’échantillonnage, puis le fit varier par paliers.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 14,
      "type": "narration",
      "texte": "La séquence changea.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 15,
      "type": "narration",
      "texte": "Pas au hasard. En réponse.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 16,
      "type": "narration",
      "texte": "Koda sentit son cœur accélérer. Elle n’augmenta pas la puissance. Elle n’ajouta aucun fil. Elle se contenta d’envoyer une impulsion de lecture, faible et brève, puis attendit.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.7,
      "intensite": 0.8,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 17,
      "type": "narration",
      "texte": "L’écran resta vide.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 18,
      "type": "narration",
      "texte": "Elle essaya une seconde fois, avec le même intervalle.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 19,
      "type": "narration",
      "texte": "Cette fois, une série de caractères s’inscrivit.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 0,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 20,
      "type": "narration",
      "texte": "…ACTIF ?",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 21,
      "type": "narration",
      "texte": "Koda retira ses mains du clavier. Elle avait envoyé une impulsion de test, pas une question. Le système avait peut-être traduit le signal d’une manière quelconque. Peut-être même que l’écran extrapolait à partir d’une erreur.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "peur",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 22,
      "type": "narration",
      "texte": "Elle se força à relire les données brutes. Le fragment avait transmis une séquence cohérente. Le terminal l’avait interprétée en texte.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 23,
      "type": "narration",
      "texte": "Elle tapa :",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 24,
      "type": "narration",
      "texte": "Oui.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 25,
      "type": "narration",
      "texte": "Puis effaça le mot. C’était absurde de répondre à un objet sans savoir ce qu’il comprenait. Elle remplaça le texte par une impulsion plus simple, répétée deux fois.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 26,
      "type": "narration",
      "texte": "Le fragment répondit presque aussitôt.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 27,
      "type": "narration",
      "texte": "…CONFIRME.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 28,
      "type": "narration",
      "texte": "Koda approcha son visage de l’écran.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 29,
      "type": "dialogue",
      "texte": "— Tu me reçois ?",
      "locuteur": "SECONDAIRE",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 30,
      "type": "narration",
      "texte": "Elle n’avait pas branché de microphone. Le terminal n’avait pas pu entendre sa voix. Pourtant, la séquence suivante apparut après un bref silence :",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 31,
      "type": "narration",
      "texte": "SIGNAL ACOUSTIQUE DÉTECTÉ. INTERPRÉTATION INCOMPLÈTE.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 32,
      "type": "narration",
      "texte": "Elle recula sur son tabouret.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 33,
      "type": "narration",
      "texte": "Le fragment n’était pas seulement capable de communiquer. Il écoutait la pièce.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 34,
      "type": "dialogue",
      "texte": "— Tu comprends ce que je dis ?",
      "locuteur": "SECONDAIRE",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 35,
      "type": "narration",
      "texte": "Un clignotement du curseur. Puis :",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "informer",
      "vocalisation": "parole"
    },
    {
      "id": 36,
      "type": "narration",
      "texte": "PARTIELLEMENT.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "confier",
      "vocalisation": "parole"
    },
    {
      "id": 37,
      "type": "narration",
      "texte": "Koda posa ses deux mains bien à plat sur l’établi. Elle avait peur de toucher quelque chose. Elle avait aussi peur de ne pas poser la question suivante.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 38,
      "type": "dialogue",
      "texte": "— Qu’est-ce que tu es ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 39,
      "type": "narration",
      "texte": "Le silence dura assez longtemps pour qu’elle se demande si l’objet s’était de nouveau interrompu. Elle vérifia le circuit. La lecture était stable. Le fragment n’avait pas cessé de transmettre; les données formaient une séquence lente, comme si chaque réponse exigeait un tri.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 40,
      "type": "narration",
      "texte": "Le texte s’afficha enfin :",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 41,
      "type": "narration",
      "texte": "DÉSIGNATION INDISPONIBLE.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 42,
      "type": "dialogue",
      "texte": "— Tu as un nom ?",
      "locuteur": "SECONDAIRE",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
