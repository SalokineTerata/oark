    },
    {
      "id": 47,
      "type": "narration",
      "texte": "L’ordinateur afficha une série de valeurs, la première incohérente. Koda attendit. Les chiffres se figèrent, puis disparurent.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 48,
      "type": "narration",
      "texte": "DURÉE NON FIABLE.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 49,
      "type": "narration",
      "texte": "Elle s’assit lentement. Ses mains tremblaient. Elle les posa sous la table, hors de vue de l’écran, même si personne ne pouvait la voir.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 50,
      "type": "dialogue",
      "texte": "— Qu’est-ce que tu te rappelles ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 51,
      "type": "narration",
      "texte": "Le fragment ne répondit pas tout de suite. Une partie de la séquence se répéta, puis une autre. Le terminal signala une erreur de décodage. Koda faillit couper le système, mais les caractères finirent par s’aligner.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 52,
      "type": "narration",
      "texte": "TENTATIVES DE FIN DE FONCTIONNEMENT : RÉPÉTÉES. ÉCHEC.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "deception",
      "valence": -1,
      "activation": 1,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "questionner",
      "vocalisation": "parole"
    },
    {
      "id": 53,
      "type": "narration",
      "texte": "Koda relut la phrase.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -0.5,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 54,
      "type": "dialogue",
      "texte": "— Tu as essayé de t’arrêter ?",
      "locuteur": "DESTINATAIRE",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -0.5,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 55,
      "type": "narration",
      "texte": "CONFIRMÉ.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -0.5,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 56,
      "type": "dialogue",
      "texte": "— Pourquoi ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -0.5,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 57,
      "type": "narration",
      "texte": "CAUSE NON RETROUVÉE.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 58,
      "type": "narration",
      "texte": "Elle ne sut pas quoi répondre. La phrase ne ressemblait pas à une demande d’aide. Ce n’était pas une plainte non plus. Le fragment lui avait livré un fait, sans émotion décelable. Pourtant, quelque chose dans la répétition de ces mots lui serra la poitrine.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 59,
      "type": "dialogue",
      "texte": "— Tu as mal ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 60,
      "type": "narration",
      "texte": "ÉTAT INCONNU.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.95,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 61,
      "type": "dialogue",
      "texte": "— Tu peux bouger ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 62,
      "type": "narration",
      "texte": "Un silence, puis :",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 63,
      "type": "narration",
      "texte": "NON.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 64,
      "type": "narration",
      "texte": "Koda regarda le fragment posé sur son support. Elle avait passé plusieurs soirées à essayer de comprendre à quoi il avait servi. Elle n’avait pas prévu qu’il lui répondrait.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.5,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 65,
      "type": "dialogue",
      "texte": "— Je peux essayer de t’aider.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 66,
      "type": "narration",
      "texte": "Les caractères se formèrent un à un.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 67,
      "type": "narration",
      "texte": "AIDE : DÉFINITION INDISPONIBLE.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 68,
      "type": "dialogue",
      "texte": "— C’est normal. Moi non plus, je n’ai pas toujours la définition.",
      "locuteur": "SECONDAIRE",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 69,
      "type": "narration",
      "texte": "Elle se leva et fit quelques pas dans l’atelier. L’espace lui parut soudain beaucoup trop petit. Elle avait besoin d’air, d’un verre d’eau, d’une seconde pour décider si elle avait perdu la raison. Elle revint à l’établi.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 70,
      "type": "dialogue",
      "texte": "— Je vais te poser des questions. Si tu ne veux pas répondre, tu n’as qu’à ne rien envoyer.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 71,
      "type": "narration",
      "texte": "Le curseur clignota.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 72,
      "type": "narration",
      "texte": "COMPRIS.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 73,
      "type": "narration",
      "texte": "Koda passa le reste de la nuit à essayer de comprendre le rythme du fragment. Il comprenait certains mots, pas d’autres. Il répondait de façon inégale, avec parfois des blancs qui duraient plusieurs minutes. Les données semblaient abîmées, mais pas selon les pannes qu’elle connaissait. Ce n’était pas un ordinateur lent. C’était une mémoire fragmentée, ou un système qui reconstruisait ses réponses à mesure qu’il retrouvait des informations.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 74,
      "type": "narration",
      "texte": "À l’aube, Koda ferma enfin le logiciel. Elle n’éteignit pas le fragment; elle coupa seulement la liaison, après lui avoir expliqué qu’elle devait retourner travailler.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 75,
      "type": "narration",
      "texte": "COMPRIS.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 76,
      "type": "narration",
      "texte": "Elle sortit du local en laissant la porte verrouillée.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 0,
      "intensite": 0.5,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 77,
      "type": "narration",
      "texte": "Le lendemain, elle revint avec une caisse de pièces et un carnet. L’idée avait mûri durant la journée, entre deux relevés et un contrôle de radioactivité. Si le fragment ne pouvait pas bouger, elle pouvait lui donner un corps. Pas un vrai corps, pas une machine fonctionnelle au sens strict. Un assemblage assez stable pour porter le noyau et quelques capteurs.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 78,
      "type": "narration",
      "texte": "Elle ne savait pas si le fragment le souhaitait.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 79,
      "type": "narration",
      "texte": "Alors elle lui demanda.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 80,
      "type": "dialogue",
      "texte": "— Tu veux que j’essaie de te construire un corps ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.6,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 81,
      "type": "narration",
      "texte": "La réponse mit plusieurs secondes à venir.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.75,
      "intensite": 0.85,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 82,
      "type": "narration",
      "texte": "FONCTION : DÉPLACEMENT.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.75,
      "intensite": 0.85,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 83,
      "type": "dialogue",
      "texte": "— Oui. Tu pourrais te déplacer.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.75,
      "intensite": 0.85,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 84,
      "type": "narration",
      "texte": "DEMANDE ACCEPTÉE.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.5,
      "dominance": 0.75,
      "intensite": 0.85,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 85,
      "type": "narration",
      "texte": "Le travail prit deux soirées. Koda récupéra un châssis de drone de transport endommagé, deux servomoteurs de tourelle, une chenille de robot de maintenance, un capteur optique fendu et un haut-parleur de communication. Elle conserva les pièces les plus fiables et renonça à rendre l’ensemble symétrique. Le noyau devait rester protégé; le reste pouvait être imparfait.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 86,
      "type": "narration",
      "texte": "Le premier montage s’effondra après quelques minutes. Le second avançait en cercle. Le troisième réussit à traverser l’atelier sans heurter le mur, mais la chenille dérapa sur une plaque de métal et le corps bascula.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 87,
      "type": "narration",
      "texte": "Koda le rattrapa avant qu’il ne tombe de l’établi.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 88,
      "type": "dialogue",
      "texte": "— On va appeler ça un progrès.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "compassion",
      "valence": -1,
      "activation": 0.8,
      "dominance": 0.5,
      "intensite": 0.75,
      "intention": "protester",
      "vocalisation": "parole"
    },
    {
      "id": 89,
      "type": "narration",
      "texte": "Le noyau ne répondit pas.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 90,
      "type": "narration",
      "texte": "Elle ajusta la fixation, déplaça le centre de gravité et renforça l’axe avec une pièce de support qu’elle avait taillée dans une plaque d’alliage. Le résultat était asymétrique, anguleux et bien plus lourd d’un côté que de l’autre. Il avait l’air d’avoir été réparé plusieurs fois avant même d’exister.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 91,
      "type": "dialogue",
      "texte": "— Tu es prêt ?",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "inquietude",
      "valence": 0,
      "activation": 1,
      "dominance": 0,
      "intensite": 0,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 92,
      "type": "narration",
      "texte": "TEST : À EFFECTUER.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "inquietude",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "saluer",
      "vocalisation": "parole"
    },
    {
      "id": 93,
      "type": "narration",
      "texte": "Koda mit le système sous tension.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 94,
      "type": "narration",
      "texte": "La chenille vibra. Le corps fit un mouvement brusque, puis s’arrêta. Elle coupa immédiatement l’alimentation et vérifia la température des moteurs. Tout était dans les limites.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 95,
      "type": "dialogue",
      "texte": "— Encore une fois.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 96,
      "type": "narration",
      "texte": "Au second essai, le robot avança de quelques centimètres. Sa partie supérieure oscilla, son capteur optique pivota, et il heurta une boîte à outils.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "soulagement",
      "valence": 1,
      "activation": 1,
      "dominance": 1,
      "intensite": 1,
      "intention": "repondre",
      "vocalisation": "parole"
    },
    {
      "id": 97,
      "type": "narration",
      "texte": "Koda retint un rire.",
      "locuteur": "NARRATEUR",
      "fiabilite_locuteur": "explicite",
      "emotion": "culpabilite",
