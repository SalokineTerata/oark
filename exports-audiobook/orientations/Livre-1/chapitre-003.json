    {
      "id": 94,
      "type": "dialogue",
      "texte": "— Borras raconte trop de choses.",
      "locuteur": "KODA",
      "fiabilite_locuteur": "deduit",
      "emotion": "culpabilite",
      "valence": -1,
      "activation": 0.8,
